# Public (already used by the app)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Canonical site URL used in emails (no trailing slash)
NEXT_PUBLIC_SITE_URL=

# Server only (never prefix with NEXT_PUBLIC_)
# Comma-separated admin emails (case-insensitive). REQUIRED: the Supabase project has open sign-up, so "logged in"
# is not "admin". Unset/empty = every /admin and /api/admin request is refused (fail closed).
ADMIN_EMAILS=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
# e.g. Julianu Codani <photos@mail.ghjulianucodani.com> (verified subdomain)
RESEND_FROM=
# >= 32 random chars: HMAC for unsubscribe links
DOWNLOAD_TOKEN_SECRET=
# >= 32 random chars: salt for hashed IP / email / visitor ids
IP_HASH_SALT=
# Resend webhook signing secret (phase 9)
RESEND_WEBHOOK_SECRET=

# Support address shown on download-page error states (fallback: /contact page)
SUPPORT_EMAIL=

# Dev/local ONLY. Set to 1 to really send mail outside production. Never set on Vercel previews.
ALLOW_EMAIL_SEND=

# Legal identity printed in every email footer (LCEN). Both required in production.
# (PUBLISHER_ADDRESS is a deprecated alias of LEGAL_POSTAL_ADDRESS)
LEGAL_SENDER_NAME=
LEGAL_POSTAL_ADDRESS=

# Secret for POST/GET /api/cron/purge-events (>= 16 chars; Vercel Cron sends it as Bearer token when CRON_SECRET is set)
CRON_SECRET=
